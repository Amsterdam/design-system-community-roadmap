{
  "name": "@amsterdam/design-system-community-roadmap",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./web --filter ./cms --filter ./storybook run dev",
    "build": "pnpm --filter ./web --filter ./cms --filter ./storybook run build",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter ./ui --filter ./web --filter ./cms --filter ./storybook run typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/prompt-cli": "^20.5.2",
    "@eslint/json": "^1.2.0",
    "@eslint/js": "^9",
    "@eslint/markdown": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/eslint-plugin": "^1.6.16",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mdx": "^3.7.0",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.3.5",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "stylelint": "^17.9.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-use-logical": "^2.1.3",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "pnpm": {
    "overrides": {
      "cms>react": "^18.3.1",
      "cms>react-dom": "^18.3.1",
      "zod": "^3.25.76",
      "lodash": "^4.18.1"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "codemirror": "5",
        "typescript": "5"
      }
    }
  }
}

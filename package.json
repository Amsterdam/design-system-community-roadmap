{
  "name": "@amsterdam/design-system-community-roadmap",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter ./web --filter ./cms --filter ./storybook run dev",
    "build": "pnpm --filter ./web --filter ./cms --filter ./storybook run build",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,scss}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter ./ui --filter ./web --filter ./cms --filter ./storybook run typecheck",
    "prepare": "husky",
    "update:major": "npm-check-updates --upgrade --workspaces --cooldown 1 && pnpm install",
    "update:minor": "npm-check-updates --target minor --upgrade --workspaces --cooldown 1 && pnpm install",
    "update:patch": "npm-check-updates --target patch --upgrade --workspaces --cooldown 1 && pnpm install"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@eslint/json": "^2.1.1",
    "@eslint/js": "^10",
    "@eslint/markdown": "^8.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-mdx": "^3.8.2",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-storybook": "^10.6.4",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-use-logical": "^2.1.3",
    "stylelint-value-no-unknown-custom-properties": "^6.1.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1"
  }
}

{
  "kind": "collectionType",
  "collectionName": "stories",
  "info": {
    "singularName": "story",
    "pluralName": "stories",
    "displayName": "Story"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 140
    },
    "content": {
      "type": "text",
      "required": true,
      "minLength": 1,
      "maxLength": 10000
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::story-like.story-like",
      "mappedBy": "story"
    },
    "reactions": {
      "type": "component",
      "component": "feed.reaction",
      "repeatable": true
    },
    "feature": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::feature.feature",
      "inversedBy": "stories"
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "startDate": {
      "type": "date",
      "required": true
    },
    "endDate": {
      "type": "date",
      "required": true
    },
    "rank": {
      "type": "integer"
    },
    "progressStatus": {
      "type": "enumeration",
      "enum": ["Bezig", "Voltooid"]
    }
  }
}

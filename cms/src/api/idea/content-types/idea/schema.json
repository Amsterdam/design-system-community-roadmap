{
  "kind": "collectionType",
  "collectionName": "ideas",
  "info": {
    "singularName": "idea",
    "pluralName": "ideas",
    "displayName": "Ideas"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "minLength": 1,
      "maxLength": 140
    },
    "content": {
      "type": "text",
      "required": true,
      "minLength": 1,
      "maxLength": 10000
    },
    "status": {
      "type": "enumeration",
      "enum": ["in_review", "accepted", "postponed"],
      "default": "in_review",
      "required": true
    },
    "features": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::feature.feature",
      "mappedBy": "idea"
    },
    "end_users": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::end-user.end-user",
      "inversedBy": "ideas"
    },
    "likes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::idea-like.idea-like",
      "mappedBy": "idea"
    },
    "reactions": {
      "type": "component",
      "component": "feed.reaction",
      "repeatable": true
    },
    "images": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    }
  }
}
